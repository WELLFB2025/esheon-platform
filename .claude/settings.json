{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/alpaca_trading_bots/**)",
      "Edit(~/alpaca_trading_bots/**)",
      "Bash(*alpaca_trading_bots*)",
      "Bash(launchctl *)",
      "Bash(sh *deploy*)",
      "Bash(bash *deploy*)",
      "Bash(*/deploy/*.sh*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(npm install *)"
    ]
  }
}
